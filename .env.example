# ---- App ----------------------------------------------------------------
APP_NAME=byebyeboss
APP_ENV=local
DEBUG=true
API_VERSION=v1

# ---- Database -----------------------------------------------------------
# Quick start (no infra needed):
DATABASE_URL=sqlite+aiosqlite:///./app.db
# Postgres (docker-compose):
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/app
DATABASE_ECHO=false
DATABASE_AUTO_CREATE=true

# ---- Security / JWT -----------------------------------------------------
SECRET_KEY=change-me-in-production-please-32chars-min
JWT_ALGORITHM=HS256
# JWT_ISSUER=my-service
# JWT_AUDIENCE=my-clients
ACCESS_TOKEN_TTL_MINUTES=30
REFRESH_TOKEN_TTL_MINUTES=10080

# Bootstrap admin (seeded at startup if not present)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=changeme123

# ---- CORS ---------------------------------------------------------------
# CORS_ALLOW_ORIGINS=["http://localhost:3000"]

# ---- Cache (optional; falls back to in-memory) --------------------------
# REDIS_URL=redis://localhost:6379/0
CACHE_DEFAULT_TTL_SECONDS=60

# ---- Rate limiting (uses Redis when REDIS_URL is set, else in-memory) ----
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT_TIMES=100
RATE_LIMIT_DEFAULT_SECONDS=60

# ---- Scheduler ----------------------------------------------------------
# Also drives the mail queue worker below.
SCHEDULER_ENABLED=true

# ---- Mail ---------------------------------------------------------------
# Outgoing mail is queued in the DB and flushed by a scheduled worker.
# MAIL_PROVIDER picks the transport: smtp | mailgun.
# If the selected provider is not configured, messages are only logged.
MAIL_PROVIDER=smtp

# -- Mailgun (MAIL_PROVIDER=mailgun) --------------------------------------
# MAILGUN_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx-xxxxxxxx-xxxxxxxx
# MAILGUN_DOMAIN=mg.example.fr
# Host or full URL. EU accounts: api.eu.mailgun.net
# MAILGUN_ENDPOINT=api.eu.mailgun.net
MAILGUN_TIMEOUT_SECONDS=15

# -- SMTP (MAIL_PROVIDER=smtp) --------------------------------------------
# Local dev with MailHog (smtp 1025, web UI http://localhost:8025):
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=false
#
# Production (OVH example):
# SMTP_HOST=ssl0.ovh.net
# SMTP_PORT=587
# SMTP_USER=contact@byebyeboss.fr
# SMTP_PASSWORD=change-me
# SMTP_STARTTLS=true
SMTP_TIMEOUT_SECONDS=15

EMAIL_FROM=contact@byebyeboss.fr
EMAIL_FROM_NAME=Bye Bye Boss

# Queue worker: how often it runs, how many mails per pass, retries before
# a message is marked failed.
MAIL_QUEUE_INTERVAL_MINUTES=1
MAIL_QUEUE_BATCH_SIZE=20
MAIL_MAX_ATTEMPTS=5

# ---- AI (CV parsing, module `cv`) ---------------------------------------
# Same OpenAI account as the `matching` module below, own (cheaper) model:
# CV parsing is a fixed-schema extraction task, not the judgment call
# matching makes, so it doesn't need a flagship-tier model.
# Revoke any key that has ever been shared, then generate a fresh one.
OPENAI_API_KEY=sk-your-key-here
CV_OPENAI_MODEL=gpt-5-mini
OPENAI_TIMEOUT_SECONDS=60
CV_MAX_UPLOAD_MB=5
# Where uploaded CV files are stored. Must be OUTSIDE the git checkout so
# they survive deploys. On the server: /var/lib/byebyeboss/cv-uploads
CV_UPLOAD_DIR=./uploads/cv

# ---- Job offers (module `offers`) ----------------------------------------
# Both are optional and independent -- ingestion simply skips a provider
# left unconfigured. Never scraped: only official APIs are integrated here.
#
# France Travail: register an app at https://francetravail.io and activate
# "Offres d'emploi v2" to get these.
FRANCE_TRAVAIL_CLIENT_ID=
FRANCE_TRAVAIL_CLIENT_SECRET=
# Adzuna: sign up at https://developer.adzuna.com to get these.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=fr
# Comma-separated search terms; how many results to request per term per
# provider per run; how often the ingestion job runs.
OFFERS_SEARCH_KEYWORDS=chef de projet,product owner,business analyst,scrum master,data analyst,développeur,consultant
OFFERS_MAX_PER_KEYWORD=50
OFFERS_INGESTION_INTERVAL_MINUTES=60

# ---- Matching (module `matching`) ----------------------------------------
# Uses the same OPENAI_API_KEY as the `cv` module above, its own (still
# flagship-tier, for now) model. Runs as a background job -- see the
# module's docstring for why. This whole block is the dominant OpenAI cost
# driver (2026-09-22 cost review). How often it runs is a fixed daily cron
# in app/modules/matching/jobs.py, not a setting -- together with
# MATCHING_MAX_OFFERS_PER_CANDIDATE below, that's the lever that matters
# most; MATCHING_OPENAI_MODEL is the next one, pending a quality check.
MATCHING_OPENAI_MODEL=gpt-5
# Separate, longer timeout than OPENAI_TIMEOUT_SECONDS: matching's "medium"
# reasoning effort is heavier than the cv module's fast "low" extraction and
# routinely takes over a minute.
MATCHING_OPENAI_TIMEOUT_SECONDS=180
# How many offers are scored at once per candidate (network-bound LLM calls,
# no shared state) -- lower this if you hit OpenAI rate-limit errors.
MATCHING_CONCURRENCY=4
MATCHING_MAX_OFFERS_PER_CANDIDATE=8
MATCHING_MAX_OFFER_POOL_DAYS=30

# ---- CV optimization ("Adapter mon CV pour cette offre") -----------------
# Uses the same OPENAI_API_KEY as the modules above, its own model setting
# -- on-demand (one call per candidate click, not a background job), so it
# doesn't carry the "runs daily for everyone" cost multiplier the matching
# settings above do. gpt-5-mini rather than the flagship gpt-5 -- explicit
# call during the current test phase (2026-09-22): no need to pay for the
# top-tier model while the feature itself is still being validated.
CV_OPTIMIZATION_OPENAI_MODEL=gpt-5-mini
# Same "medium" reasoning/verbosity as the matching call above (heavier
# judgment task than a fixed extraction schema) -- same generous timeout.
CV_OPTIMIZATION_OPENAI_TIMEOUT_SECONDS=180

# ---- Logging ------------------------------------------------------------
LOG_LEVEL=INFO
LOG_JSON=false
